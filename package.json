{
  "name": "products-csv-downloader",
  "version": "1.0.0",
  "description": "Universal E-Commerce Product Scraper & Multi-Platform CSV/JSON Exporter",
  "main": "server/index.js",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "scraper",
    "shopify-csv",
    "woocommerce-csv",
    "wix-csv",
    "product-importer"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
